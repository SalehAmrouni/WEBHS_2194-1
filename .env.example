# Copy to .env and fill in. Never commit .env.

# Required for Zeus AI. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides
# PORT=3000
# NODE_ENV=production
# ZEUS_MODEL=claude-opus-5-5
# ZEUS_EFFORT=medium            # low | medium | high
# ZEUS_DAILY_LIMIT=2000         # max chat requests per day across all users
# ZEUS_FALLBACKS=on             # set to "off" to disable server-side refusal fallbacks
# TRUST_PROXY=1                 # set when running behind a reverse proxy / load balancer
# SUBMISSIONS_DIR=./data/submissions
